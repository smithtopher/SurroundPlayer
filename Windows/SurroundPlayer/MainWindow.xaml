<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SurroundPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SurroundPlayer"
    Title="Surround Player">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          PreviewKeyDown="Root_PreviewKeyDown" PointerMoved="Root_PointerMoved"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid x:Name="Toolbar" Padding="8,6" ColumnSpacing="4"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="OpenButton" Click="Open_Click" IsTabStop="False" ToolTipService.ToolTip="Add files or folders (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" IsTabStop="False" ToolTipService.ToolTip="Add a folder">
                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <DropDownButton x:Name="DeviceButton" IsTabStop="False" ToolTipService.ToolTip="Audio output device">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="DeviceIcon" Glyph="&#xE7F4;" FontSize="14" />
                        <TextBlock x:Name="DeviceLabel" Text="Output" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DeviceMenu" Placement="BottomEdgeAlignedRight" Opening="DeviceMenu_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ToggleButton x:Name="VisToggle" Click="VisToggle_Click" IsTabStop="False"
                              ToolTipService.ToolTip="Visualiser, also in place of video (V)">
                    <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                </ToggleButton>
                <Button Click="FullScreen_Click" IsTabStop="False" ToolTipService.ToolTip="Full screen player (F)">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </Button>
                <ToggleButton x:Name="PlaylistToggle" IsChecked="True" Click="PlaylistToggle_Click" IsTabStop="False"
                              ToolTipService.ToolTip="Show or hide the playlist">
                    <FontIcon Glyph="&#xE90C;" FontSize="14" />
                </ToggleButton>
                <Button Click="Settings_Click" IsTabStop="False" ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="PlaylistColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- stage + controls -->
            <Grid x:Name="PlayerArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="Stage" Background="Black" DoubleTapped="Stage_DoubleTapped">
                    <SwapChainPanel x:Name="VideoPanel" SizeChanged="VideoPanel_SizeChanged"
                                    CompositionScaleChanged="VideoPanel_CompositionScaleChanged" />
                    <StackPanel x:Name="NowPlaying" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Padding="32">
                        <Grid Width="320" Height="320" HorizontalAlignment="Center">
                            <Border x:Name="ArtPlaceholder" CornerRadius="16" Background="#10FFFFFF">
                                <FontIcon x:Name="ArtGlyph" Glyph="&#xE7F5;" FontSize="64" Foreground="#59FFFFFF" />
                            </Border>
                            <Image x:Name="ArtImage" Stretch="Uniform" />
                        </Grid>
                        <TextBlock x:Name="StageTitle" Text="Drop music or video files here" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="White" />
                        <TextBlock x:Name="StageSubtitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="#B3FFFFFF" />
                    </StackPanel>
                    <!-- visualiser (overrides the video track when enabled) + MilkDrop-style overlays -->
                    <Grid x:Name="VisStage" Visibility="Collapsed">
                        <SwapChainPanel x:Name="VisPanel" SizeChanged="VisPanel_SizeChanged"
                                        CompositionScaleChanged="VisPanel_CompositionScaleChanged" />
                        <Border x:Name="VisPresetPill" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20"
                                Padding="10,5" CornerRadius="14" Background="#66000000" Opacity="0" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="VisLockIcon" Glyph="&#xE72E;" FontSize="12" Foreground="White" Visibility="Collapsed" />
                                <TextBlock x:Name="VisPresetText" Foreground="White" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="VisTitle" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20"
                                    Spacing="4" Opacity="0" IsHitTestVisible="False">
                            <TextBlock x:Name="VisTitleText" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="VisSubtitleText" FontSize="18" Foreground="#CCFFFFFF" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ErrorBanner" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16"
                            Padding="10" CornerRadius="8" Background="#D9C42B1C" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap" MaxWidth="700" />
                    </Border>
                </Grid>

                <!-- controls bar (overlays the picture in full screen) -->
                <Border x:Name="ControlsBar" Grid.Row="1" Padding="14,10"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        PointerEntered="ControlsBar_PointerEntered">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" Text="0:00" FontSize="12" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" IsTabStop="False"
                                    IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BarTitle" Text="Not playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="BarArtist" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Click="Previous_Click" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Previous (Ctrl+Left)">
                                    <FontIcon Glyph="&#xF8AC;" FontSize="16" />
                                </Button>
                                <Button Click="Play_Click" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Play / pause (Space)">
                                    <FontIcon x:Name="PlayGlyph" Glyph="&#xF5B0;" FontSize="22" />
                                </Button>
                                <Button Click="Next_Click" IsTabStop="False" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Next (Ctrl+Right)">
                                    <FontIcon Glyph="&#xF8AD;" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <DropDownButton x:Name="AudioTrackButton" IsTabStop="False" Visibility="Collapsed"
                                                ToolTipService.ToolTip="Audio track">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="AudioTrackMenu" Opening="AudioTrackMenu_Opening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button x:Name="OutputBadge" IsTabStop="False" Padding="6,3" MinWidth="0" MinHeight="0"
                                        CornerRadius="4" BorderThickness="0" Visibility="Collapsed">
                                    <TextBlock x:Name="OutputBadgeText" FontSize="10" FontWeight="Bold" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Width="380" Spacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="Source" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="DetailSource" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Output" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="DetailOutput" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                                <StackPanel x:Name="DetailVideoPanel">
                                                    <TextBlock Text="Video" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="DetailVideo" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- playlist -->
            <Grid x:Name="PlaylistPane" Grid.Column="1" BorderThickness="1,0,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Margin="8" PlaceholderText="Filter tracks" QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted"
                                KeyDown="SearchBox_KeyDown" />
                <ListView x:Name="PlaylistView" Grid.Row="1" SelectionMode="Extended" CanReorderItems="True" AllowDrop="True"
                          CanDragItems="True" DoubleTapped="PlaylistView_DoubleTapped" KeyDown="PlaylistView_KeyDown"
                          RightTapped="PlaylistView_RightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Track">
                            <Grid ColumnSpacing="6" Padding="0,4" ToolTipService.ToolTip="{x:Bind Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Indicator, Mode=OneWay}" FontSize="12"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Ext}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyPlaylist" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyText" Text="Drop files or folders here" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing x:Name="ScanRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="CountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <HyperlinkButton x:Name="ClearButton" Content="Clear" FontSize="12" HorizontalAlignment="Right" Padding="4,0"
                                     Click="Clear_Click" IsTabStop="False" />
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="DropHighlight" Grid.RowSpan="2" BorderThickness="3" CornerRadius="12" Margin="6"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
